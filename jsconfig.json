{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2020",
        "jsx": "react",
        "allowImportingTsExtensions": true,
        "checkJs": false,
        "strictFunctionTypes": false,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
          }
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}